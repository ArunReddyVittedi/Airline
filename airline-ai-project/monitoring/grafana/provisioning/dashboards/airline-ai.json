{
  "uid": "airline-ai",
  "title": "Airline AI",
  "tags": [
    "airline",
    "langchain4j"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Feature latency, p95",
      "type": "timeseries",
      "description": "The number a passenger feels. Split by feature, because one slow agent drags the average down for everything.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(airline_ai_feature_seconds_bucket[2m])) by (le, feature))",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Feature calls per minute, by outcome",
      "type": "timeseries",
      "description": "Failures show here even when the caller catches the error and falls back, which is most of ours.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(airline_ai_feature_seconds_count[2m])) by (feature, outcome) * 60",
          "legendFormat": "{{feature}} {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Tokens per minute",
      "type": "timeseries",
      "description": "Input and output separately, because they cost different amounts. A feature that sends a huge prompt is a different problem from one that writes essays.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(airline_ai_tokens_total[2m])) by (type) * 60",
          "legendFormat": "{{type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Chunks retrieved per request",
      "type": "timeseries",
      "description": "How much grounding each answer actually got.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(airline_ai_retrieval_documents_bucket[5m])) by (le, feature))",
          "legendFormat": "{{feature}} median",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Empty retrievals per minute",
      "type": "timeseries",
      "description": "The most important RAG signal there is. A retrieval that finds nothing does not error, it just lets the model invent a baggage allowance. Rising here means indexing broke or the score floor is too strict.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(airline_ai_retrieval_empty_total[5m])) by (feature) * 60",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Agent handoffs per minute",
      "type": "timeseries",
      "description": "Who is passing work to whom. When the supervisor starts consulting the compensation agent about baggage, it shows up here first.",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(airline_ai_agent_handoff_total[5m])) by (from, to) * 60",
          "legendFormat": "{{from}} to {{to}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Tool calls per minute",
      "type": "timeseries",
      "description": "Local tools and MCP tools separated, because an MCP tool crosses a process boundary and fails in ways a local method never will.",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(airline_ai_tool_calls_total[5m])) by (tool, source) * 60",
          "legendFormat": "{{tool}} ({{source}})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Guardrail blocks",
      "type": "stat",
      "description": "Blocked prompts and rejected answers in the last fifteen minutes.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(airline_ai_guardrail_blocked_total[15m])) by (guardrail, reason)",
          "legendFormat": "{{guardrail}} {{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 9,
      "title": "Degraded responses",
      "type": "stat",
      "description": "AI calls that failed and fell back to a plain answer. Invisible in HTTP metrics, because the request still returns 200.",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(airline_ai_degraded_total[15m])) by (feature, reason)",
          "legendFormat": "{{feature}} {{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 10,
      "title": "Per agent latency, p95",
      "type": "timeseries",
      "description": "A twelve second supervisor run is usually one slow sub agent, and this is how you find which.",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(airline_ai_agent_seconds_bucket[5m])) by (le, agent))",
          "legendFormat": "{{agent}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Model call latency, p95",
      "type": "timeseries",
      "description": "One OpenAI call. Compare with feature latency above: a big gap means the time is going into tool round trips, not the model.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(airline_ai_model_call_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "HTTP requests, p95",
      "type": "timeseries",
      "description": "Spring's own timer, for comparison. The AI endpoints should stand out clearly against the plain ones.",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[2m])) by (le, uri))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}